# Copy this file's contents into Streamlit Cloud's
# "Advanced settings -> Secrets" box when deploying (or into a local,
# gitignored .streamlit/secrets.toml for local testing).

# Included in NCBI E-utilities requests per their API etiquette guidelines.
# https://www.ncbi.nlm.nih.gov/books/NBK25497/#chapter2.Usage_Guidelines_and_Requiremen
NCBI_EMAIL = "your-email@example.com"

# Optional: enables AI-assisted plain-language summaries on variant cards.
# Leave unset to run fully without AI (cards fall back to the PubMed/template summary).
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-4-8"   # optional override; defaults to claude-opus-4-8
